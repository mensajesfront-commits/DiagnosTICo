# =============================================================================
# DiagnosTICo · plantilla del .env de PRODUCCIÓN (docker-compose.prod.yml)
#
# En el servidor: cp .env.production.example .env y completa lo que está
# entre < >. Este archivo va en el repositorio SOLO con marcadores: las claves
# reales se escriben únicamente en el .env del servidor.
# Pasos: docs/20_DESPLIEGUE.md. Qué es cada variable: .env.example.
#
# Nota: docker compose lee este archivo tal cual (env_file); no uses
# referencias como ${APP_NAME} dentro de los valores.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
APP_NAME=Captter
APP_ENV=production
# Se genera una sola vez y no se cambia (cifra sesiones y datos):
#   docker compose -f docker-compose.prod.yml run --rm --no-deps app php artisan key:generate --show
APP_KEY=<APP_KEY>
APP_DEBUG=false
APP_URL=https://diagnostico.captter.com
INERTIA_DEVTOOLS_ENABLED=false

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Puerto de 127.0.0.1 donde escucha Nginx; Apache reenvía aquí.
NGINX_PORT=8200

# --- Logs --------------------------------------------------------------------
# Archivos diarios en el volumen storage (se guardan 14 días).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Base de datos (PostgreSQL 18, servicio postgres) ------------------------
# El contenedor de PostgreSQL crea la base y el usuario con estos datos la
# primera vez que arranca. Clave larga y aleatoria, por ejemplo: openssl rand -hex 24
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=diagnostico
DB_USERNAME=diagnostico
DB_PASSWORD=<DB_PASSWORD>

# --- Redis (servicio redis): caché y cola ------------------------------------
# Clave aleatoria, por ejemplo: openssl rand -hex 24
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>
CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Más que el --timeout=120 del trabajador (docker-compose.prod.yml).
REDIS_QUEUE_RETRY_AFTER=180

# --- Sesión ------------------------------------------------------------------
# Las sesiones se quedan en PostgreSQL: el sistema borra las de una cuenta al
# desactivarla o cambiarle el rol (tabla sessions).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Enlace de "¿Olvidaste tu contraseña?": 10 minutos (RN-006).
AUTH_PASSWORD_RESET_EXPIRE=10

# --- Archivos ----------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Correo (SMTP real) ------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=<smtp o smtps>
MAIL_HOST=<MAIL_HOST>
MAIL_PORT=<MAIL_PORT>
MAIL_USERNAME=<MAIL_USERNAME>
MAIL_PASSWORD=<MAIL_PASSWORD>
MAIL_FROM_ADDRESS=<MAIL_FROM_ADDRESS>
MAIL_FROM_NAME=Captter

# --- Cuentas y soporte -------------------------------------------------------
# Correo de la cuenta principal del Administrador (lo elige NuevasTIC).
ADMIN_EMAIL=<ADMIN_EMAIL>
SOPORTE_EMAIL=contacto@captter.com
PLAZO_MINIMO_DIAS=3
ZONA_HORARIA_POR_DEFECTO=America/Bogota

# --- Inteligencia artificial (OpenAI, lo paga NuevasTIC) ---------------------
OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REQUEST_TIMEOUT=30

# --- Captcha del registro (Cloudflare Turnstile) -----------------------------
# Las llaves reales de diagnostico.captter.com (dash.cloudflare.com → Turnstile).
CAPTCHA_ACTIVO=true
TURNSTILE_SITE_KEY=<TURNSTILE_SITE_KEY>
TURNSTILE_SECRET_KEY=<TURNSTILE_SECRET_KEY>

# --- PDF (Chromium de Debian dentro de la imagen) ----------------------------
LARAVEL_PDF_CHROME_PATH=/usr/bin/chromium
LARAVEL_PDF_NO_SANDBOX=true
