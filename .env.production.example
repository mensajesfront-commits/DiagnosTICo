# =============================================================================
# Variables de PRODUCCIÓN (docker-compose.prod.yml)
#
# En el servidor: cp .env.production.example .env y completa lo que está entre < >.
# Un solo .env: Laravel lo recibe por env_file y Docker Compose lo usa para ${...}.
# Nunca subas el .env al repositorio. Explicación de cada variable: .env.example.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
APP_NAME=Captter
APP_ENV=production
# Se genera una sola vez: docker compose -f docker-compose.prod.yml run --rm artisan key:generate --show
APP_KEY=<GENERAR>
APP_DEBUG=false
APP_URL=https://<dominio>
# Auditoría QA (ERR-07): sin las herramientas de desarrollo de Inertia.
INERTIA_DEVTOOLS_ENABLED=false

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Puerto del contenedor web ------------------------------------------------
# Solo en 127.0.0.1 del servidor; el proxy con HTTPS (Apache o Nginx) apunta aquí.
WEB_PORT=8080

# --- Base de datos (servicio "pgsql" de docker-compose.prod.yml) --------------
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=diagnostico
DB_USERNAME=diagnostico
# Genera una larga, por ejemplo: openssl rand -base64 32
DB_PASSWORD=<CLAVE_SEGURA>

# --- Sesión (HTTPS) -------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Archivos, colas y caché -------------------------------------------------
# La cola la procesa el servicio "queue"; las tareas programadas, "scheduler".
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Correo (SMTP real) -------------------------------------------------------
# Configúralo antes de db:seed: al ADMIN_EMAIL le llega "Crear mi contraseña".
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<servidor-smtp>
MAIL_PORT=587
MAIL_USERNAME=<usuario-smtp>
MAIL_PASSWORD=<CLAVE_SMTP>
MAIL_FROM_ADDRESS="<correo-remitente>"
MAIL_FROM_NAME="${APP_NAME}"

# --- Cuenta principal del Administrador y contacto ---------------------------
ADMIN_EMAIL=<correo-del-administrador>
SOPORTE_EMAIL=contacto@captter.com
PLAZO_MINIMO_DIAS=3
ZONA_HORARIA_POR_DEFECTO=America/Bogota

# --- Inteligencia artificial (OpenAI, la paga NuevasTIC) ----------------------
OPENAI_API_KEY=<CLAVE_OPENAI>
OPENAI_ORGANIZATION=
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_REQUEST_TIMEOUT=30

# --- Captcha del registro (Cloudflare Turnstile): obligatorio en producción ---
CAPTCHA_ACTIVO=true
TURNSTILE_SITE_KEY=<LLAVE_DEL_SITIO>
TURNSTILE_SECRET_KEY=<LLAVE_SECRETA>

# --- PDF (Chromium dentro de la imagen) ----------------------------------------
LARAVEL_PDF_CHROME_PATH=/usr/local/bin/chromium
LARAVEL_PDF_NO_SANDBOX=true

# --- Frontend ----------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
