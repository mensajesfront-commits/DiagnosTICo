# syntax=docker/dockerfile:1
# =============================================================================
# Nginx de producción. Sirve los archivos de public/ (con el frontend ya
# compilado) y pasa lo demás a php-fpm (servicio app).
#
# Los archivos públicos se copian de la imagen de la aplicación: en
# docker-compose.prod.yml el contexto "app" apunta al servicio app
# (additional_contexts), así Nginx y PHP llevan siempre el mismo build.
# Requiere Docker Compose 2.17 o más reciente.
# =============================================================================

FROM nginx:1.29-alpine

RUN rm /etc/nginx/conf.d/default.conf
COPY docker/nginx/default.conf /etc/nginx/conf.d/diagnostico.conf
COPY --from=app /var/www/html/public /var/www/html/public

EXPOSE 80
