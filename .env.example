# =============================================================================
# Sistema de Diagnóstico de Marketing Digital · variables de entorno
#
# Copia este archivo como .env (cp .env.example .env) y completa lo que está
# entre < >. Los valores de este archivo sirven para el entorno local con Sail.
# Nunca subas el .env al repositorio: ahí van las claves reales.
# Detalle de cada entorno: docs/27_ENTORNOS.md
# =============================================================================

# --- Aplicación --------------------------------------------------------------
# Nombre que se ve en la pestaña del navegador y en los correos.
APP_NAME="Diagnóstico Empresarial"
# local, testing o production. Las rutas de la prueba técnica solo existen en local y testing.
APP_ENV=local
# Clave de cifrado. Se genera con: php artisan key:generate
APP_KEY=
# true muestra los errores con detalle. Solo en local.
APP_DEBUG=true
# Dirección donde abre el sistema. Con Sail es http://localhost (puerto 80).
APP_URL=http://localhost

# Idioma de los textos del sistema y de los datos de prueba. Mientras no
# existan las traducciones en lang/es, los mensajes del framework salen en el
# idioma de respaldo (inglés).
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# Dónde se guarda el modo mantenimiento (archivo local).
APP_MAINTENANCE_DRIVER=file

# Costo de cifrado de las contraseñas. 12 es el valor recomendado.
BCRYPT_ROUNDS=12

# --- Registro de errores (logs) ----------------------------------------------
# Canal y nivel del log. Los archivos quedan en storage/logs.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos (PostgreSQL 18) -------------------------------------------
# Con Sail el servidor se llama "pgsql". Usuario y clave son los de Sail en
# local; en otro servidor se cambian por los reales.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=diagnostico
DB_USERNAME=sail
DB_PASSWORD=password
# Alternativa a las líneas anteriores: una sola URL de conexión.
# DB_URL=<DATABASE_URL>

# --- Sesión ------------------------------------------------------------------
# Las sesiones se guardan en la base de datos y duran 120 minutos sin actividad.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Archivos, colas y caché -------------------------------------------------
# Eventos en tiempo real: no se usan (la pantalla "Analizando" consulta cada pocos segundos).
BROADCAST_CONNECTION=log
# Disco donde se guardan los PDF generados (storage/app/private).
FILESYSTEM_DISK=local
# Cola de trabajos en segundo plano (correos y análisis de la IA). Se procesa
# con: php artisan queue:work
QUEUE_CONNECTION=database
# Caché del sistema.
CACHE_STORE=database

# --- Correo ------------------------------------------------------------------
# Con Sail los correos van a Mailpit y se ven en http://localhost:8025
# (no salen a internet). En otro servidor se pone el SMTP real.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Remitente de los correos (aviso de medición, recordatorios, contraseña).
# Cámbialo por el correo real de NuevasTIC.
MAIL_FROM_ADDRESS="no-responder@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Cuenta inicial del Administrador (php artisan db:seed) -----------------
# Si dejas la contraseña vacía, el seeder genera una y la muestra en la terminal.
ADMIN_EMAIL=admin@nuevastic.co
ADMIN_PASSWORD=

# --- Inteligencia artificial (OpenAI) ----------------------------------------
# Clave de la API de OpenAI. Cada instalación pone la suya; se cobra por uso.
OPENAI_API_KEY=<OPENAI_API_KEY>
# Organización de OpenAI (opcional; solo si la clave pertenece a varias).
OPENAI_ORGANIZATION=
# Modelo que analiza cada categoría. Se cambia aquí sin tocar el código.
OPENAI_MODEL=<OPENAI_MODEL>
# Segundos máximos de espera por respuesta de OpenAI.
OPENAI_REQUEST_TIMEOUT=30

# --- PDF (spatie/laravel-pdf + Chromium) -------------------------------------
# Ruta de Chromium. La imagen de Sail lo instala en /usr/local/bin/chromium.
# Fuera de Sail, pon la ruta de tu Chrome o Chromium.
LARAVEL_PDF_CHROME_PATH=/usr/local/bin/chromium
# true desactiva el sandbox de Chromium; necesario dentro de Docker.
LARAVEL_PDF_NO_SANDBOX=true

# --- Sail (Docker) -----------------------------------------------------------
# Puertos del equipo para la aplicación, Vite, PostgreSQL y Mailpit. Cámbialos
# si ya están ocupados.
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=5432
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# --- Frontend ----------------------------------------------------------------
# Nombre de la aplicación disponible en Vue (import.meta.env.VITE_APP_NAME).
VITE_APP_NAME="${APP_NAME}"
